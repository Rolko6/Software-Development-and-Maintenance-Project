      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(cloud_forward_failures_total{job=\"gateway\"}[$__rate_interval])",
